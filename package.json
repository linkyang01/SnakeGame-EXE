{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "贪吃蛇游戏 - Windows EXE版本",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
"build": {
  "appId": "com.snake.game",
  "productName": "贪吃蛇游戏",
  "directories": {
    "output": "dist"
  },
  "publish": {
    "provider": "generic",
    "url": "https://example.com"
  },
  "win": {
    "target": "nsis",
    "artifactName": "SnakeGame_Setup_${version}.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}

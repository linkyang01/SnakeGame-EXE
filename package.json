{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "贪吃蛇游戏 - Windows EXE版本",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.snake.game",
    "productName": "贪吃蛇游戏",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com",
      "publish": "never"
    },
    "win": {
      "target": "nsis",
      "artifactName": "SnakeGame_Setup_${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "!dist",
      "!node_modules"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
